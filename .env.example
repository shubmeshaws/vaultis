# Database
DATABASE_URL="postgresql://user:password@localhost:5432/vaultis?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Node Environment
NODE_ENV="development"

# OAuth Providers
GITHUB_ID="your_github_client_id"
GITHUB_SECRET="your_github_client_secret"
GOOGLE_ID="your_google_client_id"
GOOGLE_SECRET="your_google_client_secret"

# Domain Restrictions
# Comma-separated list of allowed domains (e.g. gmail.com,prismforce.ai)
ALLOWED_DOMAINS="gmail.com,shubhameshram.com"
NEXT_PUBLIC_ALLOWED_DOMAINS_MSG="Access denied. Only @gmail.com or @shubhameshram.com domains are allowed."
